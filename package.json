{
  "name": "talenthub",
  "version": "0.1.0",
  "private": true,
  "description": "TalentHub repository workspace.",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "npm --prefix apps/web run typecheck",
    "verify:is-minor": "node scripts/verify-is-minor.mjs",
    "verify:contact-policy": "node scripts/verify-contact-policy.mjs",
    "verify:interviews-privacy-rls": "node scripts/verify-interviews-privacy-rls.mjs",
    "verify:explainable-match": "node scripts/verify-explainable-match.mjs",
    "verify:application-readiness": "node scripts/verify-application-readiness.mjs",
    "verify:readiness-timeline": "node scripts/verify-readiness-timeline.mjs",
    "verify:profile-evidence": "node scripts/verify-profile-evidence.mjs",
    "verify:phase3-security": "node scripts/verify-phase3-security.mjs",
    "verify:function-grants": "node scripts/verify-function-grants.mjs",
    "verify:identity-access": "node scripts/verify-identity-access.mjs",
    "verify:opportunities": "node scripts/verify-opportunities.mjs",
    "verify:runtime-supabase": "node scripts/verify-runtime-supabase.mjs",
    "install:web": "npm --prefix apps/web install",
    "clean": "rm -rf apps/web/.next apps/web/out apps/web/coverage"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
