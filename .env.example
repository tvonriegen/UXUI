# Copy this file to apps/web/.env.local. NEVER commit real env files.

# Supabase public browser config
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role. SERVER ONLY, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional seed endpoint protection for non-local environments.
SEED_SECRET=replace-with-a-local-secret

# Sentry optional error tracking
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# Google Analytics 4. Public measurement ID, not a secret.
# Add this to Vercel Production after deploying the integration.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-SML7WKG9GJ

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo login buttons are hidden unless explicitly enabled.
NEXT_PUBLIC_DEMO_MODE=false

# AI chatbot. Disabled by default to avoid surprise API costs.
# Set both to "true" and provide your Anthropic API key to enable.
ENABLE_AI_CHAT=false
NEXT_PUBLIC_ENABLE_AI_CHAT=false
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

# Runtime staging smoke test. Keep these values outside committed env files and
# never point them at production.
# RUNTIME_APP_URL=https://your-talenthub-domain.example
# RUNTIME_SUPABASE_URL=https://your-project-id.supabase.co
# RUNTIME_SUPABASE_ANON_KEY=your-anon-key-here
# Canonical runtime-security matrix:
# RUNTIME_PENDING_CONTACT_REQUEST_ID=fixture-contact-request-uuid
# RUNTIME_FEED_POST_ID=fixture-feed-post-uuid
# RUNTIME_STUDENT_EMAIL=fixture-minor-student-email
# RUNTIME_STUDENT_PASSWORD=fixture-student-password
# RUNTIME_COMPANY_EMAIL=fixture-company-email
# RUNTIME_COMPANY_PASSWORD=fixture-company-password
# RUNTIME_SCHOOL_EMAIL=fixture-school-email
# RUNTIME_SCHOOL_PASSWORD=fixture-school-password
# RUNTIME_EXTERNAL_EMAIL=fixture-external-email
# RUNTIME_EXTERNAL_PASSWORD=fixture-external-password
# RUNTIME_SECOND_SCHOOL_EMAIL=optional-second-school-email
# RUNTIME_SECOND_SCHOOL_PASSWORD=optional-second-school-password
# RUNTIME_SECOND_STUDENT_EMAIL=optional-second-student-email
# RUNTIME_SECOND_STUDENT_PASSWORD=optional-second-student-password
