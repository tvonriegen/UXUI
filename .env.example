# Copy this file to apps/web/.env.local. NEVER commit real env files.

# Supabase public browser config
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role. SERVER ONLY, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional seed endpoint protection for non-local environments.
SEED_SECRET=replace-with-a-local-secret

# Sentry optional error tracking
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI chatbot. Disabled by default to avoid surprise API costs.
# Set both to "true" and provide your Anthropic API key to enable.
ENABLE_AI_CHAT=false
NEXT_PUBLIC_ENABLE_AI_CHAT=false
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
